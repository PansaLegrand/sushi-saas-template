# -----------------------------------------------------------------------------
# App Basics & URLs
# -----------------------------------------------------------------------------
# What this deployment is.
#
#   app   the SaaS starter kit — auth, billing, storage, admin. The default,
#         and what you want if you cloned this template.
#   site  the project's own marketing and documentation site: a landing page
#         and /docs, with every signed-in surface returning 404. Reads no
#         database, so DATABASE_URL, BETTER_AUTH_SECRET, Stripe, Resend, and
#         the storage credentials below are all optional in this mode.
NEXT_PUBLIC_SITE_MODE=app

NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=Sushi SaaS
NEXT_PUBLIC_PROJECT_NAME=sushi-saas-template
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Enabled public locales. Use "en" for English-only, "en,es" for English + Spanish,
# or leave the full list to ship every bundled translation.
NEXT_PUBLIC_LOCALES=en,zh,es,fr,ja
NEXT_PUBLIC_LOCALE_DETECTION=true

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Example: postgresql://user:password@localhost:5432/sushi_saas
DATABASE_URL=

# Throwaway database for the `tests/db` tier (`pnpm test:db`). Left unset, that
# tier skips. Its tables are TRUNCATED between tests, so the database name must
# contain "test" — never point this at DATABASE_URL. See tests/README.md.
# Example: postgresql://localhost:5432/sushi_test
TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication (Better Auth) & Social Providers
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth is optional.
# Dev redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile — bot protection on sign-in, sign-up, password reset, and
# verification-email endpoints. Both keys are REQUIRED in production unless you
# opt out explicitly with NEXT_PUBLIC_CAPTCHA_ENABLED=false.
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Cloudflare's always-passes test keys (local development only):
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# Shared secret for the Vercel Cron endpoint (/api/cron/jobs). Vercel sends it
# as an Authorization header automatically once set on the project. Required in
# production; generate with: openssl rand -hex 32
CRON_SECRET=

NEXT_PUBLIC_CAPTCHA_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Required for password reset, welcome, payment, and reservation emails.
RESEND_API_KEY=
EMAIL_FROM="Your Name <founder@your-domain.com>"

# Local development: print password-reset and email-verification links to the
# server log instead of sending them. Leave both variables above empty and this
# happens automatically — set this to true when you *do* have a Resend key in
# .env but do not want local signups mailing real inboxes.
#
# The app refuses to start in production with this on, because the failure would
# be silent: every reset link would land in a log file and no user would get one.
AUTH_DEV_EMAIL_LINKS=false

# -----------------------------------------------------------------------------
# Payments (Stripe)
# -----------------------------------------------------------------------------
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public payment routes. These can be relative or absolute.
NEXT_PUBLIC_PAY_SUCCESS_URL=/pricing
NEXT_PUBLIC_PAY_FAIL_URL=/pricing
NEXT_PUBLIC_PAY_CANCEL_URL=/pricing

# -----------------------------------------------------------------------------
# Plans & tiers
# -----------------------------------------------------------------------------
# Required in production. These stable Stripe Prices drive checkout, tier
# mapping, and renewal credit grants — a price that is not listed here entitles
# nothing, and the sync raises a Slack alert rather than guessing.
#
# Amounts and grants live in src/config/billing.ts; capabilities and limits live
# in src/config/plans.ts. See docs/plans.md.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY_CNY=
STRIPE_PRICE_PLUS_YEARLY_CNY=
STRIPE_PRICE_MAX_MONTHLY_CNY=
STRIPE_PRICE_MAX_YEARLY_CNY=

# Deprecated public aliases are still honoured so existing deployments and
# grandfathered subscriptions keep working. New setups should use the
# server-only names above; browser code never needs Stripe Price IDs.
NEXT_PUBLIC_STRIPE_PRICE_PLUS_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PLUS_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_MAX_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_MAX_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_PLUS_MONTHLY_CNY=
NEXT_PUBLIC_STRIPE_PRICE_PLUS_YEARLY_CNY=
NEXT_PUBLIC_STRIPE_PRICE_MAX_MONTHLY_CNY=
NEXT_PUBLIC_STRIPE_PRICE_MAX_YEARLY_CNY=
NEXT_PUBLIC_STRIPE_PRICE_LAUNCH_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_SCALE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_LAUNCH_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_SCALE_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_LAUNCH_MONTHLY_CNY=
NEXT_PUBLIC_STRIPE_PRICE_SCALE_MONTHLY_CNY=
NEXT_PUBLIC_STRIPE_PRICE_LAUNCH_YEARLY_CNY=
NEXT_PUBLIC_STRIPE_PRICE_SCALE_YEARLY_CNY=

# -----------------------------------------------------------------------------
# Storage (S3-compatible: Cloudflare R2, AWS S3, MinIO)
# -----------------------------------------------------------------------------
# Pick one provider with env only; the app uses the same S3-compatible adapter.
# See docs/storage-providers.md for R2, AWS S3, MinIO, CORS, and smoke tests.
#
# R2 example:
#   STORAGE_PROVIDER=r2
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   S3_FORCE_PATH_STYLE=true
#
# AWS S3 example:
#   STORAGE_PROVIDER=s3
#   STORAGE_ENDPOINT=
#   STORAGE_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=false
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_MAX_UPLOAD_MB=25
NEXT_PUBLIC_UPLOAD_MAX_MB=25

# Provider tuning. Path style is useful for R2/MinIO and unnecessary for most
# AWS S3 buckets. ACLs should stay off unless your bucket explicitly needs them.
S3_FORCE_PATH_STYLE=true
S3_USE_ACL=false

# Optional AWS-style aliases. Prefer STORAGE_* above for new setups.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# -----------------------------------------------------------------------------
# Analytics & Ads (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_ADCODE=

# -----------------------------------------------------------------------------
# Demo Feature Flags
# -----------------------------------------------------------------------------
# Demo helpers are disabled by default. Enable them only for local development
# or explicit demo environments; they are ignored in production.
ENABLE_DEMO_FEATURES=false
ENABLE_CREDITS_PLAYGROUND=false
ENABLE_TEXT2VIDEO_MOCK=false
TEXT2VIDEO_MOCK_URL=

NEXT_PUBLIC_FEATURE_RESERVATIONS_ENABLED=true
RESERVATIONS_AUTO_SEED_DEMO=false
NEXT_PUBLIC_RESERVATIONS_AUTO_SEED_DEMO=false

# Disabled by default. Also requires ENABLE_DEMO_FEATURES=true.
ENABLE_ACCOUNT_CREDIT_GRANT=false

# Maximum credits a single admin grant may issue. Guards against a typo in the
# admin console. Defaults to 100000.
ADMIN_MAX_CREDIT_GRANT=100000

# Distributed rate limiting. Required in production app mode; production boot
# fails if it is absent. `pnpm setup` points this at the local Redis container.
# Managed production services normally provide a TLS `rediss://` URL containing
# any username/password.
RATE_LIMIT_REDIS_URL=

# Real Redis integration test. `pnpm setup` fills this with the local service.
# The test only deletes its own UUID-prefixed key; it never flushes the database.
TEST_REDIS_URL=

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
# Content Security Policy mode. Anything other than "enforce" is report-only,
# which is the default: an enforced policy that is wrong breaks the site in a
# way that only shows up in production. Ship report-only, watch the reports,
# then switch. See docs/security-headers.md.
CSP_MODE=report-only

# Optional. Where the browser POSTs CSP violation reports. Without it,
# report-only violations appear in the browser console and nowhere else.
CSP_REPORT_URI=

# -----------------------------------------------------------------------------
# Logging & Notifications
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SLACK_WEBHOOK_URL=
