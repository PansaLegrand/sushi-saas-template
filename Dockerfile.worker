# syntax=docker/dockerfile:1.7
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs ./
COPY scripts/prepare.mjs scripts/prepare.mjs
COPY apps/content-studio/package.json apps/content-studio/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter sushi-saas-starter
COPY . .
RUN pnpm bundle:runtime -- --out-dir /out/scripts

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runner
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 APP_ROOT=/app
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs worker
WORKDIR /app
COPY --from=builder --chown=worker:nodejs /out/scripts ./scripts
COPY --from=builder --chown=worker:nodejs /workspace/src/db/migrations ./src/db/migrations
USER worker
STOPSIGNAL SIGTERM
CMD ["node", "scripts/jobs-worker.mjs", "--production"]
