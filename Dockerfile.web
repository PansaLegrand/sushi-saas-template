# syntax=docker/dockerfile:1.7
FROM node:20.19.5-alpine@sha256:6178e78b972f79c335df281f4b7674a2d85071aae2af020ffa39f0a770265435 AS base
ENV PNPM_HOME=/pnpm NEXT_TELEMETRY_DISABLED=1
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS dependencies
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts/prepare.mjs scripts/prepare.mjs
COPY apps/content-studio/package.json apps/content-studio/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter sushi-saas-starter

FROM base AS builder
WORKDIR /workspace
COPY --from=dependencies /workspace/node_modules ./node_modules
COPY . .
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
ARG NEXT_PUBLIC_WEB_URL=http://localhost:3000
ARG NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3001
ARG NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000
ARG NEXT_PUBLIC_CAPTCHA_ENABLED=false
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ARG NEXT_PUBLIC_DEFAULT_LOCALE=en
ARG NEXT_PUBLIC_LOCALES=en
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_PROJECT_NAME
ARG NEXT_PUBLIC_DOCS_URL
ARG NEXT_PUBLIC_AUTH_ENABLED=true
ARG NEXT_PUBLIC_DEFAULT_THEME=system
ARG NEXT_PUBLIC_LOCALE_DETECTION=false
ARG NEXT_PUBLIC_PAY_SUCCESS_URL
ARG NEXT_PUBLIC_PAY_FAIL_URL
ARG NEXT_PUBLIC_PAY_CANCEL_URL
ARG NEXT_PUBLIC_UPLOAD_MAX_MB=25
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ARG NEXT_PUBLIC_GOOGLE_ADCODE
ARG NEXT_PUBLIC_FEATURE_RESERVATIONS_ENABLED=false
ARG NEXT_PUBLIC_RESERVATIONS_AUTO_SEED_DEMO=false
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL \
    NEXT_PUBLIC_ADMIN_WEB_URL=$NEXT_PUBLIC_ADMIN_WEB_URL \
    NEXT_PUBLIC_AUTH_BASE_URL=$NEXT_PUBLIC_AUTH_BASE_URL \
    NEXT_PUBLIC_CAPTCHA_ENABLED=$NEXT_PUBLIC_CAPTCHA_ENABLED \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_PUBLIC_DEFAULT_LOCALE=$NEXT_PUBLIC_DEFAULT_LOCALE \
    NEXT_PUBLIC_LOCALES=$NEXT_PUBLIC_LOCALES \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME \
    NEXT_PUBLIC_PROJECT_NAME=$NEXT_PUBLIC_PROJECT_NAME \
    NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL \
    NEXT_PUBLIC_AUTH_ENABLED=$NEXT_PUBLIC_AUTH_ENABLED \
    NEXT_PUBLIC_DEFAULT_THEME=$NEXT_PUBLIC_DEFAULT_THEME \
    NEXT_PUBLIC_LOCALE_DETECTION=$NEXT_PUBLIC_LOCALE_DETECTION \
    NEXT_PUBLIC_PAY_SUCCESS_URL=$NEXT_PUBLIC_PAY_SUCCESS_URL \
    NEXT_PUBLIC_PAY_FAIL_URL=$NEXT_PUBLIC_PAY_FAIL_URL \
    NEXT_PUBLIC_PAY_CANCEL_URL=$NEXT_PUBLIC_PAY_CANCEL_URL \
    NEXT_PUBLIC_UPLOAD_MAX_MB=$NEXT_PUBLIC_UPLOAD_MAX_MB \
    NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=$NEXT_PUBLIC_GOOGLE_ANALYTICS_ID \
    NEXT_PUBLIC_GOOGLE_ADCODE=$NEXT_PUBLIC_GOOGLE_ADCODE \
    NEXT_PUBLIC_FEATURE_RESERVATIONS_ENABLED=$NEXT_PUBLIC_FEATURE_RESERVATIONS_ENABLED \
    NEXT_PUBLIC_RESERVATIONS_AUTO_SEED_DEMO=$NEXT_PUBLIC_RESERVATIONS_AUTO_SEED_DEMO
RUN pnpm build:web

FROM node:20.19.5-alpine@sha256:6178e78b972f79c335df281f4b7674a2d85071aae2af020ffa39f0a770265435 AS runner
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs
COPY --from=builder --chown=nextjs:nodejs /workspace/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /workspace/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /workspace/public ./public
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "server.js"]
