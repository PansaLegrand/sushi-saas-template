# This database belongs only to Content Studio. Never point it at DATABASE_URL,
# which is the SaaS application's database.
CONTENT_DATABASE_URL=postgresql://sushi:sushi@localhost:5432/sushi_content
PAYLOAD_SECRET=
CONTENT_STUDIO_URL=http://localhost:3002

# Optional adopting-product website integration. This is intentionally not the
# Sushi SaaS presentation site; each generated starter connects its own public
# site or frontend consumer.
PUBLIC_SITE_REVALIDATE_URL=
CONTENT_REVALIDATION_SECRET=

# Marketing delivery gateway in the SaaS app. Both apps must use the same
# CONTENT_MARKETING_SECRET; unsubscribe and recipient data stay in the SaaS.
SAAS_MARKETING_API_URL=http://localhost:3000
CONTENT_MARKETING_SECRET=

# Comma-separated browser origins allowed to use Payload APIs.
CONTENT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional. Protects the Payload job runner endpoint on serverless deployments.
CRON_SECRET=

# Production media storage. Local disk is used only when these are absent.
CONTENT_STORAGE_BUCKET=
CONTENT_STORAGE_REGION=
CONTENT_STORAGE_ENDPOINT=
CONTENT_STORAGE_ACCESS_KEY=
CONTENT_STORAGE_SECRET_KEY=
CONTENT_STORAGE_FORCE_PATH_STYLE=false
