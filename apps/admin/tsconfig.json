{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@/.source": ["./.source/index.ts"],
      "@/*": ["./src/*"],
      "@admin/*": ["./apps/admin/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../src/**/*.ts",
    "../../src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
