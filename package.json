{
  "name": "sushi-saas-starter",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.19.0 <23",
    "pnpm": "10.22.0"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "cross-env NODE_NO_WARNINGS=1 next dev --turbopack",
    "dev:webpack": "pnpm dev:web:webpack",
    "dev:web:webpack": "cross-env NODE_NO_WARNINGS=1 next dev",
    "dev:admin": "cross-env NODE_NO_WARNINGS=1 next dev apps/admin --turbopack -p 3001",
    "prebuild": "pnpm test:run",
    "build": "pnpm build:web && pnpm build:admin",
    "build:web": "next build",
    "build:admin": "next build apps/admin",
    "start": "pnpm start:web",
    "start:web": "NODE_NO_WARNINGS=1 next start",
    "start:admin": "NODE_NO_WARNINGS=1 next start apps/admin -p 3001",
    "lint": "pnpm lint:web && pnpm lint:admin",
    "lint:web": "next lint --max-warnings 0",
    "lint:admin": "next lint apps/admin --max-warnings 0",
    "setup": "node scripts/setup-dev.mjs",
    "admin:promote": "node scripts/admin-promote.mjs",
    "reconcile:stripe": "tsx scripts/reconcile-stripe-billing.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate --config src/db/config.ts",
    "db:migrate": "drizzle-kit migrate --config src/db/config.ts",
    "db:studio": "drizzle-kit studio --config src/db/config.ts",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "db:check:prod": "node scripts/migrate.mjs --check",
    "test": "vitest",
    "test:fast": "vitest run --project mocked --project components",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:db": "vitest run tests/db",
    "test:db:setup": "node scripts/setup-test-db.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@daypicker/react": "^10.0.1",
    "@next/third-parties": "^15.5.22",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-email/render": "^1.1.2",
    "@stripe/stripe-js": "^5.4.0",
    "@tabler/icons-react": "^3.31.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.439.0",
    "next": "15.5.22",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.4",
    "pino": "^9.4.0",
    "postgres": "^3.4.9",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "6.1.0",
    "resend": "^4.8.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.22",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.36.0",
    "eslint-config-next": "^15.5.22",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pino-pretty": "^11.3.0",
    "postcss": "^8.5.24",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vercel": "39.1.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "better-call>zod": "^4.3.6",
      "defu": "^6.1.7",
      "esbuild": "^0.25.12",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.0",
      "jsondiffpatch": "^0.7.2",
      "mdast-util-to-hast": "^13.2.1",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.24",
      "qs": "^6.15.2",
      "rollup": "^4.59.0",
      "sharp": "^0.35.3",
      "vite": "^7.3.5"
    }
  }
}
