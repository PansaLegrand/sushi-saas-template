{
  "name": "sushi-saas-template",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.19.0 <23",
    "pnpm": "10.22.0"
  },
  "author": "pansalegrand",
  "homepage": "https://www.sushi-templates.com",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "fumadocs-mdx && cross-env NODE_NO_WARNINGS=1 next dev --turbopack",
    "dev:site": "fumadocs-mdx && cross-env NODE_NO_WARNINGS=1 NEXT_PUBLIC_SITE_MODE=site next dev --turbopack -p 3002",
    "dev:webpack": "pnpm dev:web:webpack",
    "dev:web:webpack": "fumadocs-mdx && cross-env NODE_NO_WARNINGS=1 next dev",
    "dev:admin": "cross-env NODE_NO_WARNINGS=1 next dev apps/admin --turbopack -p 3001",
    "prebuild": "pnpm test:run",
    "build": "pnpm build:web && pnpm build:admin",
    "build:web": "next build",
    "build:admin": "next build apps/admin",
    "build:site": "cross-env NEXT_PUBLIC_SITE_MODE=site next build",
    "start": "pnpm start:web",
    "start:web": "NODE_NO_WARNINGS=1 next start",
    "start:admin": "NODE_NO_WARNINGS=1 next start apps/admin -p 3001",
    "lint": "pnpm lint:web && pnpm lint:admin",
    "lint:web": "next lint --max-warnings 0",
    "lint:admin": "next lint apps/admin --max-warnings 0",
    "gen:sitemap": "node scripts/generate-sitemap.mjs",
    "setup": "node scripts/setup-dev.mjs",
    "admin:promote": "node scripts/admin-promote.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate --config src/db/config.ts",
    "db:migrate": "drizzle-kit migrate --config src/db/config.ts",
    "db:studio": "drizzle-kit studio --config src/db/config.ts",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "db:check:prod": "node scripts/migrate.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:db": "vitest run tests/db",
    "test:db:setup": "node scripts/setup-test-db.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^0.1.11",
    "@ai-sdk/openai": "^1.1.13",
    "@ai-sdk/openai-compatible": "^0.0.17",
    "@ai-sdk/provider": "^1.0.8",
    "@ai-sdk/provider-utils": "^2.0.7",
    "@ai-sdk/replicate": "^0.1.10",
    "@aws-sdk/client-s3": "^3.701.0",
    "@aws-sdk/s3-request-presigner": "^3.701.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.3",
    "@next/third-parties": "^15.1.2",
    "@openrouter/ai-sdk-provider": "^0.0.6",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-email/render": "^1.1.2",
    "@stripe/stripe-js": "^5.4.0",
    "@tabler/icons-react": "^3.31.0",
    "@types/mdx": "^2.0.13",
    "ai": "^4.1.64",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.3.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "creem": "^0.3.37",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "fumadocs-core": "^15.6.3",
    "fumadocs-mdx": "^11.6.11",
    "fumadocs-ui": "^15.6.3",
    "lucide-react": "^0.439.0",
    "next": "15.2.6",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.4",
    "openai": "^4.78.1",
    "pino": "^9.4.0",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.8.0",
    "server-only": "0.0.1",
    "simple-flakeid": "^0.0.5",
    "sonner": "^1.7.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.1.3",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.1",
    "eslint": "9.36.0",
    "eslint-config-next": "^15.2.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pino-pretty": "^11.3.0",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vercel": "39.1.1",
    "vitest": "^3.2.4"
  }
}
